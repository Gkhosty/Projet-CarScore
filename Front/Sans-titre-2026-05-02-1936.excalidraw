      "isDeleted": false,
      "boundElements": [],
      "updated": 1781105148626,
      "link": null,
      "locked": false,
      "text": "2018 — 8 ans d'ancienneté. La dépréciation annuelle est estimée à 9 %, ce qui représente environ 720 € de perte de valeur par an.",
      "fontSize": 14.058807235400328,
      "fontFamily": 6,
      "textAlign": "left",
