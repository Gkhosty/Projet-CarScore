      "updated": 1777747574147,
      "link": null,
      "locked": false,
      "text": "\nRejoignez CarScore et obtenez une analyse complète et personnalisée de votre voiture, fondée\nsur les données réelles du marché automobile français.\n\n",
      "fontSize": 20.95004023765356,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "\nRejoignez CarScore et obtenez une analyse complète et personnalisée de votre voiture, fondée sur les données réelles du marché automobile français.\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
