    {
      "id": "kcUXW0gbXrKvtyByg83ua",
      "type": "text",
      "x": 6102.2786943402425,
      "y": 3208.707729646087,
      "width": 1066.4832228717314,
      "height": 80.58985763984253,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3H",
      "roundness": null,
      "seed": 302743473,
      "version": 2063,
      "versionNonce": 415279778,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777755164308,
      "link": null,
      "locked": false,
      "text": "La période la plus favorable pour céder un véhicule en France se situe entre mars et juin, avant les départs en\nvacances. Les transactions sont plus nombreuses et les prix mieux soutenus. L'automne et l'hiver sont\ngénéralement moins propices à la revente.",
      "fontSize": 21.49062870395801,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La période la plus favorable pour céder un véhicule en France se situe entre mars et juin, avant les départs en vacances. Les transactions sont plus nombreuses et les prix mieux soutenus. L'automne et l'hiver sont généralement moins propices à la revente.",
      "autoResize": false,
      "lineHeight": 1.25
    },
