    },
    {
      "id": "GYOR8Wh6dniWBb6aN65Vt",
      "type": "text",
      "x": 5496.926527669035,
      "y": 2372.968237517561,
      "width": 832.6199969956061,
      "height": 17.573509044250393,
      "angle": 0,
      "strokeColor": "#846358",
