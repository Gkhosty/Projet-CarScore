      "isDeleted": false,
      "boundElements": [],
      "updated": 1781105148626,
      "link": null,
      "locked": false,
      "text": "65 000 km — cohérent avec l'ancienneté du véhicule. Ce niveau de kilométrage n'affecte pas significativement la valeur de revente.",
      "fontSize": 14.058807235400328,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "65 000 km — cohérent avec l'ancienneté du véhicule. Ce niveau de kilométrage n'affecte pas significativement la valeur de revente.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ElATPJGPy8fcKnjslqgM8",
      "type": "text",
      "x": 5499.335996169224,
      "y": 2551.9549486496126,
      "width": 832.6199969956061,
      "height": 17.573509044250407,
      "angle": 0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
